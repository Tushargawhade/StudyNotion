# Server port
PORT=4000

# MongoDB connection string (Atlas or local)
DB_URL=mongodb+srv://<username>:<password>@<cluster>/studyverse

# JWT secret for signing tokens
JWT_SECRET=your-secret-key

# Cloudinary credentials
CLOUD_NAME=your-cloud-name
API_KEY=your-api-key
API_SECRET=your-api-secret
FOLDER_NAME=StudyVerse

# Nodemailer SMTP credentials (e.g. Gmail app password)
MAIL_HOST=smtp.gmail.com
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Frontend origin allowed by CORS (defaults to http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Razorpay (not yet used - reserved for real payments)
# RAZORPAY_KEY=your-razorpay-key
# RAZORPAY_SECRET=your-razorpay-secret
